{
  "manifest_version": 3,
  "name": "ondevice-smoke",
  "version": "1.0.0",
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ondevice-smoke@nobait.example"
    }
  },
  "permissions": [],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://cdn-lfs.hf.co/*",
    "https://cdn-lfs-us-1.hf.co/*",
    "https://*.hf.co/*",
    "https://jsdelivr.net/*",
    "https://cdn.jsdelivr.net/*"
  ]
}