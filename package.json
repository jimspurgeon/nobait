{
  "name": "nobait",
  "version": "0.1.0",
  "description": "Replaces clickbait YouTube titles with factual alternatives, swaps thumbnails with real video frames, and adds credibility stamps.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev:firefox": "node build.config.mjs --minify=false",
    "dev:chrome": "echo 'Chrome build arrives in a later phase'",
    "build:firefox": "node build.config.mjs --minify=true",
    "build:chrome": "echo 'Chrome build arrives in a later phase'",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "echo 'E2E tests arrive in a later phase (Playwright, Firefox + Chromium)'"
  },
  "repository": {
    "type": "git",
    "url": "https://example.com/nobait.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/webextension-polyfill": "^0.12.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "webextension-polyfill": "^0.12.0"
  }
}
