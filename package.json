{
  "name": "nobait",
  "version": "0.1.0",
  "description": "Replaces clickbait YouTube titles with factual alternatives, swaps thumbnails with real video frames, and adds credibility stamps.",
  "type": "module",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:firefox": "node scripts/build.mjs --watch",
    "dev:chrome": "cross-env VITE_TARGET=chrome vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "node scripts/build.mjs",
    "build:chrome": "cross-env VITE_TARGET=chrome vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src && prettier --check src",
    "lint:fix": "eslint src --fix && prettier --write src"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.3.4",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "@wllama/wllama": "^3.8.1",
    "@wllama/wllama-compat": "^3.8.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^30.1.2",
    "playwright": "^1.49.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
