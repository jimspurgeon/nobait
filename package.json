{
  "name": "nobait",
  "version": "0.3.0",
  "description": "Replace clickbait YouTube titles with AI-generated, factual alternatives",
  "type": "module",
  "scripts": {
    "dev:firefox": "vite build --watch --mode development",
    "dev:chrome": "VITE_TARGET=chrome vite build --watch --mode development",
    "build:firefox": "VITE_TARGET=firefox vite build",
    "build:chrome": "VITE_TARGET=chrome vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "firefox",
    "extension",
    "youtube",
    "clickbait",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/webextension-polyfill": "^0.10.7",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
