{
  "manifest_version": 3,
  "name": "nobait",
  "version": "0.1.0",
  "description": "Replaces clickbait YouTube titles with factual alternatives, real video frames, and adds credibility stamps.",
  "homepage_url": "https://github.com/jimspurgeon/nobait",

  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },

  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.ytimg.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nobait@nobait.example",
      "strict_min_version": "115.0"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "options_ui": {
    "page": "assets/options.html",
    "open_in_tab": true
  }
}
